{
    "env": {
        "browser": true,
        "es6": true
    },
    "extends": [
        "airbnb-base"
    ],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": 2018,
        "sourceType": "module"
    },
    "rules": {
        "import/extensions": [
            "error",
            "always",
            {
                "ignorePackages": true
            }
        ],
        "no-param-reassign": [
            "error",
            {
                "props": true,
                "ignorePropertyModificationsFor": [
                    "data"
                ]
            }
        ]
    },
    "overrides": [
        {
            "files": [
                "test/**"
            ],
            "env": {
                "node": true
            },
            "globals": {
                "globalThis": "writable"
            },
            "rules": {
                "import/no-unresolved": "off"
            }
        }
    ]
}
